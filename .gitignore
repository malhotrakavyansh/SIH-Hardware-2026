# audio corpora -- never in git
src/kws/data/**
!src/kws/data/**/
!src/kws/data/**/README.md
!src/kws/data/**/.gitkeep

# ...except the maintainer's OWN recordings (raw takes). Public GSC and anything a
# script regenerates (recordings_trimmed/, recordings_derived/, synthetic background)
# stay out.
!src/kws/data/recordings/**
!src/kws/data/raw_sessions/**
!src/kws/data/positives/**
!src/kws/data/hard_neg/**
!src/kws/data/background/background_ambient_*.wav

# training output
src/kws/artifacts/
*.tflite
*.h5
*.keras
*.ckpt*

# the firmware handoff bundle ships its model on purpose
!firmware_handoff/**

# downloaded ASR model weights -- never in git
src/models/**
!src/models/**/
!src/models/**/README.md

# python
__pycache__/
*.py[cod]
.venv*/
venv/
.ipynb_checkpoints/

# os
Thumbs.db
desktop.ini
.DS_Store

# migration scratch (reference only, not for repo)
SIH_TEMPLATE_STRUCTURE.txt
